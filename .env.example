# --- Game modes ---
# Demo Mode: skips auth, demo evolution levels (3/6), deterministic fallbacks, reset-save button.
NEXT_PUBLIC_DEMO_MODE=true
# Film Mode: 30s timers, +25% creature scale, slower animation beats, hides debug UI.
NEXT_PUBLIC_FILM_MODE=false

# --- AI (optional; deterministic fallbacks cover everything) ---
# Claude quiz + creature-line + taunt generation
ANTHROPIC_API_KEY=
# Nano Banana Pro (Gemini) sprite generation
GEMINI_API_KEY=

# --- Supabase (optional in Demo Mode; localStorage is used instead) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
